{
  "$schema": "https://app.kilo.ai/config.json",
  "auto_collapse_reasoning": false,
  "terminal_command_display": "expanded",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "ls *": "allow",
      "tree *": "allow",
      "pwd *": "allow",
      "echo *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "type *": "allow",
      "file *": "allow",
      "diff *": "allow",
      "du *": "allow",
      "df *": "allow",
      "date *": "allow",
      "uname *": "allow",
      "whoami *": "allow",
      "printenv *": "allow",
      "man *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "ag *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "jq *": "allow",
      "*>*": "ask"
    },
    "external_directory": "ask",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "ask",
    "codesearch": "allow"
  },
  "disabled_providers": [],
  "provider": {
    "ollama-local": {
      "name": "Ollama (Local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://100.107.251.96:11434/v1"
      },
      "models": {
        "deepseek-r1-24k:latest": {
          "name": "deepseek-r1-24k:latest",
          "reasoning": true,
          "tool_call": true
        },
        "qwen3-coder-64k:latest": {
          "name": "qwen3-coder-64k:latest",
          "tool_call": true
        },
        "qwen3-embedding-8b:latest": {
          "name": "qwen3-embedding-8b:latest"
        },
        "qwen3.8-27b:latest": {
          "name": "qwen3.8-27b:latest",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 16384
          }
        }
      }
    }
  },
  "model": "ollama-local/qwen3.8-27b:latest",
  "agent": {
    "plan": {
      "model": "ollama-local/qwen3.8-27b:latest"
    },
    "orchestrator": {
      "model": "ollama-local/qwen3.8-27b:latest"
    },
    "debug": {
      "model": "ollama-local/qwen3.8-27b:latest"
    },
    "code": {
      "model": "ollama-local/qwen3.8-27b:latest"
    },
    "ask": {
      "model": "ollama-local/qwen3.8-27b:latest"
    }
  },
  "web_search": true,
  "indexing": {
    "enabled": true,
    "provider": "ollama",
    "model": "qwen3-embedding-8b:latest",
    "dimension": 4096,
    "vectorStore": "lancedb",
    "ollama": {
      "baseUrl": "http://100.107.251.96:11434"
    }
  }
}
